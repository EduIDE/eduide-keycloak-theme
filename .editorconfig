root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

# Keycloak reads these as UTF-8. Trailing whitespace is significant in a
# properties value, so it is not trimmed here.
[*.properties]
indent_size = 4
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
